// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.


.create-merge table PatientVitalsRaw (event_id:string, event_type:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, schema_version:real, payload:dynamic) 
.create-merge table PrescriptionEventsRaw (event_id:string, event_type:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, schema_version:real, payload:dynamic) 
.create-merge table PatientVitals (event_id:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, patient_id:string, encounter_id:string, hadm_id:string, unit_id:string, bed_id:string, device_id:string, charttime:datetime, loinc_code:string, parameter_name:string, value_num:real, value_uom:string, warning:bool, is_artifact:bool) 
.create-merge table PrescriptionEvents (event_id:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, subject_id:string, hadm_id:string, encounter_id:string, pharmacy_id:long, poe_id:string, poe_seq:int, order_provider_id:string, drug:string, drug_type:string, formulary_drug_cd:string, gsn:long, ndc:string, rxcui_scd:long, prod_strength:string, dose_val_rx:real, dose_unit_rx:string, form_val_disp:int, form_unit_disp:string, doses_per_24_hrs:real, route:string, frequency:string, proc_type:string, status:string, fhir_status:string, fhir_intent:string, fhir_priority:string, entertime:datetime, verifiedtime:datetime, starttime:datetime, stoptime:datetime, dispensation:string, fill_quantity:int, is_controlled:bool, dea_schedule:string, unit_id:string, event_subtype:string) 
.create-or-alter function with (skipvalidation = "true") ExpandPatientVitals() {
    PatientVitalsRaw
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        patient_id = tostring(payload.patient_id),
        encounter_id = tostring(payload.encounter_id),
        hadm_id = tostring(payload.hadm_id),
        unit_id = tostring(payload.unit_id),
        bed_id = tostring(payload.bed_id),
        device_id = tostring(payload.device_id),
        charttime = todatetime(payload.charttime),
        loinc_code = tostring(payload.loinc_code),
        parameter_name = tostring(payload.parameter_name),
        value_num = todouble(payload.value_num),
        value_uom = tostring(payload.value_uom),
        warning = tobool(payload.warning),
        is_artifact = tobool(payload.is_artifact)
}
.create-or-alter function with (skipvalidation = "true") ExpandPrescriptionEvents() {
    PrescriptionEventsRaw
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        subject_id = tostring(payload.subject_id),
        hadm_id = tostring(payload.hadm_id),
        encounter_id = tostring(payload.encounter_id),
        pharmacy_id = tolong(payload.pharmacy_id),
        poe_id = tostring(payload.poe_id),
        poe_seq = toint(payload.poe_seq),
        order_provider_id = tostring(payload.order_provider_id),
        drug = tostring(payload.drug),
        drug_type = tostring(payload.drug_type),
        formulary_drug_cd = tostring(payload.formulary_drug_cd),
        gsn = tolong(payload.gsn),
        ndc = tostring(payload.ndc),
        rxcui_scd = tolong(payload.rxcui_scd),
        prod_strength = tostring(payload.prod_strength),
        dose_val_rx = todouble(payload.dose_val_rx),
        dose_unit_rx = tostring(payload.dose_unit_rx),
        form_val_disp = toint(payload.form_val_disp),
        form_unit_disp = tostring(payload.form_unit_disp),
        doses_per_24_hrs = todouble(payload.doses_per_24_hrs),
        route = tostring(payload.route),
        frequency = tostring(payload.frequency),
        proc_type = tostring(payload.proc_type),
        status = tostring(payload.status),
        fhir_status = tostring(payload.fhir_status),
        fhir_intent = tostring(payload.fhir_intent),
        fhir_priority = tostring(payload.fhir_priority),
        entertime = todatetime(payload.entertime),
        verifiedtime = todatetime(payload.verifiedtime),
        starttime = todatetime(payload.starttime),
        stoptime = todatetime(payload.stoptime),
        dispensation = tostring(payload.dispensation),
        fill_quantity = toint(payload.fill_quantity),
        is_controlled = tobool(payload.is_controlled),
        dea_schedule = tostring(payload.dea_schedule),
        unit_id = tostring(payload.unit_id),
        event_subtype = tostring(payload.event_subtype)
}
.alter table PatientVitalsRaw policy retention @'{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PatientVitalsRaw policy caching hotdata = time(60.00:00:00) hotindex = time(60.00:00:00)
.alter table PrescriptionEventsRaw policy retention @'{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PrescriptionEventsRaw policy caching hotdata = time(60.00:00:00) hotindex = time(60.00:00:00)
.alter table PatientVitals policy retention @'{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PatientVitals policy caching hotdata = time(60.00:00:00) hotindex = time(60.00:00:00)
.alter table PrescriptionEvents policy retention @'{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PrescriptionEvents policy caching hotdata = time(60.00:00:00) hotindex = time(60.00:00:00)
.alter table PatientVitals policy update "[{\"IsEnabled\":true,\"Source\":\"PatientVitalsRaw\",\"Query\":\"ExpandPatientVitals()\",\"IsTransactional\":true,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table PrescriptionEvents policy update "[{\"IsEnabled\":true,\"Source\":\"PrescriptionEventsRaw\",\"Query\":\"ExpandPrescriptionEvents()\",\"IsTransactional\":true,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"

// Quarantine: rows that fail basic validity checks or arrive with excessive
// clock skew (event_time vs ingest_time), per the architecture diagram's
// "Validate • dedupe" requirement on the Eventhouse. Non-transactional so a
// quarantine-detection bug can never block the main raw landing.

.create-merge table PatientVitalsQuarantine (event_id:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, quarantine_reason:string, quarantined_at:datetime, raw_payload:dynamic)
.create-merge table PrescriptionEventsQuarantine (event_id:string, event_time:datetime, ingest_time:datetime, source_system:string, facility_id:string, quarantine_reason:string, quarantined_at:datetime, raw_payload:dynamic)

.create-or-alter function with (skipvalidation = "true") QuarantinePatientVitals() {
    PatientVitalsRaw
    | extend charttime_parsed = todatetime(payload.charttime)
    | extend value_num_parsed = todouble(payload.value_num)
    | extend patient_id_str = tostring(payload.patient_id)
    | extend lag_minutes = datetime_diff('minute', ingest_time, event_time)
    | where isnull(charttime_parsed) or isnull(value_num_parsed) or isempty(patient_id_str)
        or lag_minutes > 60 or lag_minutes < -5
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        quarantine_reason = case(
            isnull(charttime_parsed), "unparseable_charttime",
            isnull(value_num_parsed), "missing_or_invalid_value_num",
            isempty(patient_id_str), "missing_patient_id",
            lag_minutes > 60, strcat("late_arrival_", tostring(lag_minutes), "min"),
            lag_minutes < -5, "ingest_before_event_time",
            "unknown"),
        quarantined_at = now(),
        raw_payload = payload
}

.create-or-alter function with (skipvalidation = "true") QuarantinePrescriptionEvents() {
    PrescriptionEventsRaw
    | extend entertime_parsed = todatetime(payload.entertime)
    | extend subject_id_str = tostring(payload.subject_id)
    | extend lag_minutes = datetime_diff('minute', ingest_time, event_time)
    | where isnull(entertime_parsed) or isempty(subject_id_str)
        or lag_minutes > 60 or lag_minutes < -5
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        quarantine_reason = case(
            isnull(entertime_parsed), "unparseable_entertime",
            isempty(subject_id_str), "missing_subject_id",
            lag_minutes > 60, strcat("late_arrival_", tostring(lag_minutes), "min"),
            lag_minutes < -5, "ingest_before_event_time",
            "unknown"),
        quarantined_at = now(),
        raw_payload = payload
}

.alter table PatientVitalsQuarantine policy retention '{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PrescriptionEventsQuarantine policy retention '{"SoftDeletePeriod":"180.00:00:00","Recoverability":"Enabled"}'
.alter table PatientVitalsQuarantine policy update "[{\"IsEnabled\":true,\"Source\":\"PatientVitalsRaw\",\"Query\":\"QuarantinePatientVitals()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"
.alter table PrescriptionEventsQuarantine policy update "[{\"IsEnabled\":true,\"Source\":\"PrescriptionEventsRaw\",\"Query\":\"QuarantinePrescriptionEvents()\",\"IsTransactional\":false,\"PropagateIngestionProperties\":false,\"ManagedIdentity\":null}]"

// Dedup: the generator's event_id is a deterministic uuid5, so at-least-once
// Kafka redelivery produces exact-duplicate event_ids, not new ones. These
// materialized views keep the latest-ingested copy of each event_id and are
// the "hot aggregates" the operational report should query, not the raw
// typed tables directly.

.create-or-alter materialized-view PatientVitalsDeduped on table PatientVitals { PatientVitals | summarize arg_max(ingest_time, *) by event_id }
.create-or-alter materialized-view PrescriptionEventsDeduped on table PrescriptionEvents { PrescriptionEvents | summarize arg_max(ingest_time, *) by event_id }
