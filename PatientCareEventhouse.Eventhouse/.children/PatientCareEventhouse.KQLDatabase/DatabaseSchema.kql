// KQL script
// Use management commands in this script to configure your database items, such as tables, functions, materialized views, and more.
//
// Real-time layer for the two confirmed streaming sources (DATA-CONTRACT.md §4-5):
// stream/patient-vitals and stream/prescription-events. Bed capacity and staffing are
// explicitly NOT streamed — see CLAUDE.md "Bed capacity and staffing are batch, not real-time".
//
// Pattern: a *Raw table lands the envelope columns plus the payload as a single dynamic
// column, exactly as the Eventstream delivers it. An update policy fans each raw row out
// into a typed table via a bag_unpack-based function, so KQL queries and the operational
// report's DirectQuery model never have to parse JSON at query time.

.create-merge table PatientVitalsRaw (
    event_id: string,
    event_type: string,
    event_time: datetime,
    ingest_time: datetime,
    source_system: string,
    facility_id: string,
    schema_version: real,
    payload: dynamic
)

.create-merge table PrescriptionEventsRaw (
    event_id: string,
    event_type: string,
    event_time: datetime,
    ingest_time: datetime,
    source_system: string,
    facility_id: string,
    schema_version: real,
    payload: dynamic
)

.create-merge table PatientVitals (
    event_id: string,
    event_time: datetime,
    ingest_time: datetime,
    source_system: string,
    facility_id: string,
    patient_id: string,
    encounter_id: string,
    hadm_id: string,
    unit_id: string,
    bed_id: string,
    device_id: string,
    charttime: datetime,
    loinc_code: string,
    parameter_name: string,
    value_num: real,
    value_uom: string,
    warning: bool,
    is_artifact: bool
)

.create-merge table PrescriptionEvents (
    event_id: string,
    event_time: datetime,
    ingest_time: datetime,
    source_system: string,
    facility_id: string,
    subject_id: string,
    hadm_id: string,
    encounter_id: string,
    pharmacy_id: long,
    poe_id: string,
    poe_seq: int,
    order_provider_id: string,
    drug: string,
    drug_type: string,
    formulary_drug_cd: string,
    gsn: long,
    ndc: string,
    rxcui_scd: long,
    prod_strength: string,
    dose_val_rx: real,
    dose_unit_rx: string,
    form_val_disp: int,
    form_unit_disp: string,
    doses_per_24_hrs: real,
    route: string,
    frequency: string,
    proc_type: string,
    status: string,
    fhir_status: string,
    fhir_intent: string,
    fhir_priority: string,
    entertime: datetime,
    verifiedtime: datetime,
    starttime: datetime,
    stoptime: datetime,
    dispensation: string,
    fill_quantity: int,
    is_controlled: bool,
    dea_schedule: string,
    unit_id: string,
    event_subtype: string
)

.create-or-alter function ExpandPatientVitals() {
    PatientVitalsRaw
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        patient_id = tostring(payload.patient_id),
        encounter_id = tostring(payload.encounter_id),
        hadm_id = tostring(payload.hadm_id),
        unit_id = tostring(payload.unit_id),
        bed_id = tostring(payload.bed_id),
        device_id = tostring(payload.device_id),
        charttime = todatetime(payload.charttime),
        loinc_code = tostring(payload.loinc_code),
        parameter_name = tostring(payload.parameter_name),
        value_num = todouble(payload.value_num),
        value_uom = tostring(payload.value_uom),
        warning = tobool(payload.warning),
        is_artifact = tobool(payload.is_artifact)
}

.create-or-alter function ExpandPrescriptionEvents() {
    PrescriptionEventsRaw
    | project
        event_id,
        event_time,
        ingest_time,
        source_system,
        facility_id,
        subject_id = tostring(payload.subject_id),
        hadm_id = tostring(payload.hadm_id),
        encounter_id = tostring(payload.encounter_id),
        pharmacy_id = tolong(payload.pharmacy_id),
        poe_id = tostring(payload.poe_id),
        poe_seq = toint(payload.poe_seq),
        order_provider_id = tostring(payload.order_provider_id),
        drug = tostring(payload.drug),
        drug_type = tostring(payload.drug_type),
        formulary_drug_cd = tostring(payload.formulary_drug_cd),
        gsn = tolong(payload.gsn),
        ndc = tostring(payload.ndc),
        rxcui_scd = tolong(payload.rxcui_scd),
        prod_strength = tostring(payload.prod_strength),
        dose_val_rx = todouble(payload.dose_val_rx),
        dose_unit_rx = tostring(payload.dose_unit_rx),
        form_val_disp = toint(payload.form_val_disp),
        form_unit_disp = tostring(payload.form_unit_disp),
        doses_per_24_hrs = todouble(payload.doses_per_24_hrs),
        route = tostring(payload.route),
        frequency = tostring(payload.frequency),
        proc_type = tostring(payload.proc_type),
        status = tostring(payload.status),
        fhir_status = tostring(payload.fhir_status),
        fhir_intent = tostring(payload.fhir_intent),
        fhir_priority = tostring(payload.fhir_priority),
        entertime = todatetime(payload.entertime),
        verifiedtime = todatetime(payload.verifiedtime),
        starttime = todatetime(payload.starttime),
        stoptime = todatetime(payload.stoptime),
        dispensation = tostring(payload.dispensation),
        fill_quantity = toint(payload.fill_quantity),
        is_controlled = tobool(payload.is_controlled),
        dea_schedule = tostring(payload.dea_schedule),
        unit_id = tostring(payload.unit_id),
        event_subtype = tostring(payload.event_subtype)
}

.alter table PatientVitals policy update
```
[
    {
        "IsEnabled": true,
        "Source": "PatientVitalsRaw",
        "Query": "ExpandPatientVitals()",
        "IsTransactional": true,
        "PropagateIngestionProperties": false
    }
]
```

.alter table PrescriptionEvents policy update
```
[
    {
        "IsEnabled": true,
        "Source": "PrescriptionEventsRaw",
        "Query": "ExpandPrescriptionEvents()",
        "IsTransactional": true,
        "PropagateIngestionProperties": false
    }
]
```

// Operational dashboard reads recent activity only (GENERATOR-README: 30-60 days of vitals
// is enough to answer "what needs action today"). [ASSUMPTION] 60-day hot cache / 180-day
// retention — no client-confirmed retention requirement exists yet; revisit once one does.
.alter table PatientVitalsRaw policy retention softdelete = 180d
.alter table PatientVitalsRaw policy caching hot = 60d
.alter table PatientVitals policy retention softdelete = 180d
.alter table PatientVitals policy caching hot = 60d
.alter table PrescriptionEventsRaw policy retention softdelete = 180d
.alter table PrescriptionEventsRaw policy caching hot = 60d
.alter table PrescriptionEvents policy retention softdelete = 180d
.alter table PrescriptionEvents policy caching hot = 60d
